{
  "config_path": "./config",
  "output_path": "./output/kinms_mock_unlensed_pixelized/",
  "data_directory": "./data/kinms_mock_unlensed",
  "uids": [
    "kinms_mock_unlensed"
  ],
  "width": "30kms",
  "data_patterns": {
    "frequencies": "frequencies_{uid}_width_{width}_contsub.fits",
    "uv_wavelengths": "uv_wavelengths_{uid}_width_{width}_contsub.fits",
    "visibilities": "visibilities_{uid}_width_{width}_contsub.fits",
    "sigma": "sigma_statwt_{uid}_width_{width}_contsub.fits"
  },
  "redshift_lens": 0.404,
  "redshift_source": 2.7855,
  "n_pixels": 40,
  "pixel_scale": "nyquist",
  "real_space_width": 5.0,
  "source_grid": {
    "n_pixels": 40
  },
  "rest_line_frequency_ghz": 1036.912393,
  "model_name": "KinMSPixelized",
  "normalization_mode": "pixelized",
  "lensing": {
    "enabled": false
  },
  "flip_kinms_y_before_lensing": true,
  "flip_velocity_axis": false,
  "mock_pad_channels_each_side": 4,
  "truth_parameters": {
    "z_centre": 0.0,
    "centre_0": 0.0,
    "centre_1": 0.0,
    "phi": 90.0,
    "inclination": 65.0,
    "turnover_radius": 0.05,
    "maximum_velocity": 320.0,
    "velocity_dispersion": 35.0,
    "vmax_black_hole": 0.0
  },
  "free_lens_centre": false,
  "lens_centre_half_width": 0.05,
  "lens_mass_model": {
    "centre_0": 0.0,
    "centre_1": 0.0,
    "einstein_radius": 0.0,
    "elliptical_comps_0": 0.0,
    "elliptical_comps_1": 0.0,
    "slope": 2.0,
    "shear_elliptical_comps_0": 0.0,
    "shear_elliptical_comps_1": 0.0,
    "multipole_m3_elliptical_comps_0": 0.0,
    "multipole_m3_elliptical_comps_1": 0.0,
    "multipole_m4_elliptical_comps_0": 0.0,
    "multipole_m4_elliptical_comps_1": 0.0
  },
  "plot": true,
  "write_dirty_data_cube": false,
  "write_dirty_model_cube": false,
  "reconstruction": {
    "fix_lens": true,
    "mesh_type": "rectangular_uniform",
    "mesh_shape": [
      20,
      20
    ],
    "use_jax": true,
    "transformer": "dft",
    "mask_n_pixels": 40,
    "mask_radius": 2.5,
    "flux_threshold": 0.0,
    "max_radius": 1.5,
    "use_positive_only_solver": true,
    "sb_input_units": "jy_per_pixel_per_channel",
    "flux_snr_threshold": 0.5,
    "moment0": {
      "sigma_mode": "independent_mean",
      "sigma_scale": 1.0,
      "uv_mode": "average"
    },
    "regularization": {
      "type": "adapt",
      "prior_type": "log_uniform",
      "inner_coefficient": {
        "lower_limit": 0.01,
        "upper_limit": 100.0
      },
      "outer_coefficient": {
        "prior_type": "fixed",
        "value": 50.0
      },
      "signal_scale": {
        "prior_type": "fixed",
        "value": 3.0
      }
    },
    "search": {
      "path_prefix": "kinms_mock_unlensed_pixelized",
      "name": "reconstruction",
      "optimizer": "LBFGS",
      "use_jax_gradient": true,
      "number_of_cores": 1,
      "maxiter": 200
    },
    "clouds_per_pixel": 64,
    "disk_scale_height_kpc": 0.1
  },
  "priors": {
    "centre_0": {
      "type": "UniformPrior",
      "lower_limit": -0.05,
      "upper_limit": 0.05
    },
    "centre_1": {
      "type": "UniformPrior",
      "lower_limit": -0.05,
      "upper_limit": 0.05
    },
    "z_centre": {
      "type": "UniformPrior",
      "lower_limit": -10.0,
      "upper_limit": 10.0
    },
    "phi": {
      "type": "UniformPrior",
      "lower_limit": 70.0,
      "upper_limit": 110.0
    },
    "inclination": {
      "type": "UniformPrior",
      "lower_limit": 55.0,
      "upper_limit": 75.0
    },
    "maximum_velocity": {
      "type": "UniformPrior",
      "lower_limit": 280.0,
      "upper_limit": 360.0
    },
    "velocity_dispersion": {
      "type": "UniformPrior",
      "lower_limit": 20.0,
      "upper_limit": 50.0
    },
    "turnover_radius": {
      "type": "LogUniformPrior",
      "lower_limit": 0.03,
      "upper_limit": 0.07
    },
    "vmax_black_hole": {
      "type": "fixed",
      "value": 0.0
    }
  },
  "search": {
    "path_prefix": "kinms_mock_unlensed_pixelized",
    "name": "truth_kinematics_fit",
    "n_live": 20,
    "number_of_cores": 1
  },
  "disk_scale_height_kpc": 0.1
}
